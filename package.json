{
  "name": "voidtrace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0 <27.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "spec:gen": "node tools/spec-gen/src/main.ts",
    "spec:check": "node tools/spec-check/src/main.ts",
    "toolchain:check": "node tools/check-toolchain.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "boundary:check": "node tools/check-boundaries.ts",
    "test": "vitest run",
    "check": "pnpm toolchain:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundary:check && pnpm spec:check && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
