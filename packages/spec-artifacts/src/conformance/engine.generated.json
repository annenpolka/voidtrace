{
  "kind": "voidtrace.engine-conformance",
  "schemaVersion": "0.1.0",
  "sourceFingerprint": "sha256:87422d3a3c0c701eaea653935340d5ca365863afd65797255365442d5c510d43",
  "activeClauses": [
    {
      "id": "CLI-001",
      "pattern": "cli_command_output_selection",
      "desc": "helpメタデータ要求を除き、describe実行成功時はCapability Manifest、run実行成功時はResult、trace実行成功時はTraceだけをstdoutへ出力する",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CLI-002",
      "pattern": "cli_deterministic_json",
      "desc": "同一のコマンド引数とArtifact入力は同一のcanonical単一行JSONを生成し、pretty表示はJSON値を変更しない",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CLI-003",
      "pattern": "cli_stream_exit_discipline",
      "desc": "describe、run、traceのdomain実行成功はexit 0と選択されたJSONだけをstdoutへ出し、domain実行失敗はstdoutを空にしてProblemだけをstderrへ出し、input=2、unsupported=3、limit=4、internal=5へ分類する。helpメタデータ要求はexit 0の人間可読stdoutとする",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CLI-004",
      "pattern": "cli_alias_equivalence",
      "desc": "voidtraceとvtは同一引数に対してstdout、stderr、exit codeがbyte単位で一致する",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CLI-005",
      "pattern": "cli_application_boundary",
      "desc": "CLIは引数解析、Artifact入出力、表示選択だけを担当し、評価意味論と能力記述をApplication APIへ委譲する",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CLI-006",
      "pattern": "cli_input_surface",
      "desc": "describeはArtifact入力を取らず、runとtraceは<scenario-source>と必須--catalog <catalog-source>を取り、各sourceはJSONファイルpathまたはstdinを表す「-」とする。両sourceを同時に「-」にはできず、評価はApplication APIが生成core Rulesetを選択し、暗黙fixtureを使わない",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "cli"
    },
    {
      "id": "CRT-002",
      "pattern": "fixed_critical_tier",
      "desc": "deterministic固定tierは0または1だけを受理し、tier 0は倍率1、tier 1はCatalogのcriticalMultiplierを適用する",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "DEF-001",
      "pattern": "armor_monotonic",
      "desc": "標準Armor式300/(Armor+300)では、他条件が同一ならArmor増加によってHealth Damageは増加しない",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "DEF-002",
      "pattern": "armor_formula_example",
      "desc": "golden.direct-critical-armorにおいて、標準Armor 300では許容誤差0.000001以内でHealth Damage倍率が0.5となる",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "DMG-001",
      "pattern": "damage_vector_identity",
      "desc": "ModifierなしのDirect Hitでは、damage.construct直後のDamage VectorがCatalog入力と一致する",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "DMG-002",
      "pattern": "damage_total_equals_components",
      "desc": "各Damage Vectorのtotalは有限な非負成分の総和と一致する",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "ENG-001",
      "pattern": "deterministic_replay",
      "desc": "同一Catalog、Ruleset、Scenario、seedは同一のcanonical Resultを返す",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "kernel"
    },
    {
      "id": "ENG-002",
      "pattern": "event_time_monotonic",
      "desc": "Event Queueから処理されるイベント時刻は後退しない",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "kernel"
    },
    {
      "id": "GOL-001",
      "pattern": "golden_scenario",
      "desc": "data/fixtures/golden/direct-critical-armor.scenario.jsonは独立literal expected vectorと一致するResultおよびTraceを生成する",
      "guarantee": "example-tested",
      "maturity": "active",
      "area": "mechanics"
    },
    {
      "id": "RNG-001",
      "pattern": "same_logical_random",
      "desc": "同一seed、論理Event ID、roll purposeは同一乱数を返す",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "kernel"
    },
    {
      "id": "SCP-001",
      "pattern": "scope_boundary",
      "desc": "物理・衝突・軌道は解決済みHitPlanとして入力され、Kernelは幾何学的命中判定を行わない",
      "guarantee": "manual",
      "maturity": "active",
      "area": "scope"
    },
    {
      "id": "SCP-002",
      "pattern": "unsupported_mechanic_rejected",
      "desc": "非対応メカニクスをゼロ効果として黙って無視せず、構造化された非対応結果を返す",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "scope"
    },
    {
      "id": "TRC-001",
      "pattern": "trace_reconstructs_result",
      "desc": "Traceの順序付きDamage Vector操作を再生するとResultの最終Damage Vectorと一致する",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "kernel"
    },
    {
      "id": "TRC-002",
      "pattern": "rejected_rule_has_reason",
      "desc": "不適用RuleのTrace decisionにはrejection stageと安定した構造化理由が存在する",
      "guarantee": "property-tested",
      "maturity": "active",
      "area": "kernel"
    }
  ],
  "plannedClauses": [
    {
      "id": "CRT-001",
      "pattern": "critical_tier_probability_sum",
      "desc": "Critical tier確率分布を実装するとき、その確率総和は1となる",
      "guarantee": "property-tested",
      "maturity": "planned",
      "area": "mechanics"
    }
  ]
}
