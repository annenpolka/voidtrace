{
  "$schema": "urn:voidtrace:schema:ruleset:0.12.0",
  "kind": "ruleset",
  "schemaVersion": "0.12.0",
  "id": "ruleset.synthetic-core",
  "revision": 1,
  "contentHash": "sha256:448726631b8f022d7248235f194b00a05bb283c57d35e4aef6641597e0b54146",
  "gameBuild": "synthetic-fixture-0",
  "rules": [
    {
      "id": "rule.multishot.emit-fixed-hits",
      "description": "Expand one action with an explicit positive safe-integer hit count into that many stable ordered Direct Hit child events, bounded by the operation execution limit.",
      "phase": "attack.emit",
      "eventKind": "action.multishot-direct-hit",
      "reads": [
        "action.multishot-hit-count"
      ],
      "writes": [
        "event.direct-hit-count"
      ],
      "operation": {
        "kind": "event.expand-fixed-multishot",
        "maximumHits": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.pellet.emit-fixed-hits",
      "description": "Expand one action with an explicit positive safe-integer pellet count into that many stable ordered Direct Hit child events, bounded by the operation execution limit.",
      "phase": "attack.emit",
      "eventKind": "action.pellet-direct-hit",
      "reads": [
        "action.pellet-count"
      ],
      "writes": [
        "event.direct-hit-count"
      ],
      "operation": {
        "kind": "event.expand-fixed-pellets",
        "maximumPellets": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.status.schedule-resolved-ticks",
      "description": "Expand one explicit resolved Status action into a bounded count of ordered logical-time tick events.",
      "phase": "attack.emit",
      "eventKind": "action.resolved-status-ticks",
      "reads": [
        "action.status-tick-count",
        "action.status-tick-interval-ms"
      ],
      "writes": [
        "event.status-tick-count"
      ],
      "operation": {
        "kind": "event.expand-resolved-status-ticks",
        "maximumTicks": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.punch-through.expand-resolved-targets",
      "description": "Expand one explicit resolved punch-through path into a bounded ordered sequence of target Direct Hit events.",
      "phase": "attack.emit",
      "eventKind": "action.resolved-punch-through-direct-hits",
      "reads": [
        "action.target-path-count"
      ],
      "writes": [
        "event.direct-hit-count"
      ],
      "operation": {
        "kind": "event.expand-resolved-punch-through-targets",
        "maximumTargets": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.ricochet.expand-resolved-targets",
      "description": "Expand one explicit resolved ricochet path into a bounded ordered sequence of target Direct Hit events.",
      "phase": "attack.emit",
      "eventKind": "action.resolved-ricochet-direct-hits",
      "reads": [
        "action.target-path-count"
      ],
      "writes": [
        "event.direct-hit-count"
      ],
      "operation": {
        "kind": "event.expand-resolved-ricochet-targets",
        "maximumTargets": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.chain.expand-resolved-targets",
      "description": "Expand one explicit resolved chain path into a bounded ordered sequence of target Direct Hit events.",
      "phase": "attack.emit",
      "eventKind": "action.resolved-chain-direct-hits",
      "reads": [
        "action.target-path-count"
      ],
      "writes": [
        "event.direct-hit-count"
      ],
      "operation": {
        "kind": "event.expand-resolved-chain-targets",
        "maximumTargets": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.expand-resolved-targets",
      "description": "Expand one explicit resolved impact-distance relation set into bounded target Radial events.",
      "phase": "attack.emit",
      "eventKind": "action.resolved-radial-targets",
      "reads": [
        "action.impact-target-count"
      ],
      "writes": [
        "event.radial-target-count"
      ],
      "operation": {
        "kind": "event.expand-resolved-radial-targets",
        "maximumTargets": 64
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.critical.resolve-expected-branches",
      "description": "For non-negative Critical chance c, resolve the same safe adjacent-tier probability distribution as explicit-roll resolution without selecting a realized tier.",
      "phase": "critical.expected",
      "eventKind": "damage.direct",
      "reads": [
        "attack.critical-chance"
      ],
      "writes": [
        "event.critical-base-tier",
        "event.critical-next-tier",
        "event.critical-fraction",
        "event.critical-base-tier-probability",
        "event.critical-next-tier-probability"
      ],
      "operation": {
        "kind": "critical-tier.resolve-expected-branches"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.damage.direct-hit",
      "description": "For a resolved Direct Hit without modifiers, copy the Catalog attack mode base Damage Vector unchanged into event damage.",
      "phase": "damage.construct",
      "eventKind": "damage.direct",
      "reads": [
        "attack.base-damage"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.copy"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.construct-hit",
      "description": "Copy the Catalog attack mode base Damage Vector into one resolved Radial Hit.",
      "phase": "damage.construct",
      "eventKind": "damage.radial",
      "reads": [
        "attack.base-damage"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.copy"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.critical.resolve-tier-roll",
      "description": "For non-negative Critical chance c, let baseTier = floor(c) and fraction = c - baseTier. baseTier must be a safe integer; nextTier is baseTier when fraction is 0, otherwise baseTier + 1 and must also be safe. Resolve p(baseTier) = 1 - fraction and p(nextTier) = fraction from an explicit roll in [0, 1): nextTier exactly when roll is less than fraction, otherwise baseTier.",
      "phase": "critical.roll",
      "eventKind": "damage.direct",
      "reads": [
        "attack.critical-chance",
        "event.critical-roll"
      ],
      "writes": [
        "event.critical-tier",
        "event.critical-base-tier",
        "event.critical-next-tier",
        "event.critical-fraction",
        "event.critical-base-tier-probability",
        "event.critical-next-tier-probability"
      ],
      "operation": {
        "kind": "critical-tier.resolve-tier-roll"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.critical.scale-tier",
      "description": "For a resolved non-negative safe-integer Critical tier t and Catalog Critical multiplier M, scale event damage by 1 + t * (M - 1).",
      "phase": "critical.resolve",
      "eventKind": "damage.direct",
      "reads": [
        "event.damage",
        "event.critical-tier",
        "attack.critical-multiplier"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.scale-critical-tier"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.scale-critical-tier",
      "description": "Scale one resolved Radial Hit by the same explicit fixed Critical tier operation as the synthetic Direct Hit slice.",
      "phase": "critical.resolve",
      "eventKind": "damage.radial",
      "reads": [
        "event.damage",
        "event.critical-tier",
        "attack.critical-multiplier"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.scale-critical-tier"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.apply-resolved-falloff",
      "description": "Scale one Radial Hit after Critical and before Armor by an explicit finite resolved multiplier in the closed interval [0, 1].",
      "phase": "damage.radial-falloff",
      "eventKind": "damage.radial",
      "reads": [
        "event.damage",
        "event.radial-falloff-multiplier"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.scale-resolved-radial-falloff"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.status.construct-resolved-tick",
      "description": "Construct one synthetic Status tick Damage Vector from explicit resolved Health damage without deriving a Status formula.",
      "phase": "status.tick",
      "eventKind": "damage.status-tick",
      "reads": [
        "status.resolved-health-damage-per-tick"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.copy-resolved-status-tick"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.defense.standard-armor",
      "description": "For non-negative resolved Armor on the Health layer, multiply event damage by constant / (Armor + constant), where constant is 300.",
      "phase": "target.mitigate",
      "eventKind": "damage.direct",
      "reads": [
        "event.damage",
        "target.armor"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.scale-standard-armor",
        "constant": 300
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.standard-armor",
      "description": "Apply the synthetic standard Armor operation to one Radial Hit after resolved falloff.",
      "phase": "target.mitigate",
      "eventKind": "damage.radial",
      "reads": [
        "event.damage",
        "target.armor"
      ],
      "writes": [
        "event.damage"
      ],
      "operation": {
        "kind": "damage-vector.scale-standard-armor",
        "constant": 300
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.damage.commit-health",
      "description": "Commit the final Direct Hit Damage Vector to the resolved Health layer and record the remaining Health.",
      "phase": "damage.commit",
      "eventKind": "damage.direct",
      "reads": [
        "event.damage",
        "target.health"
      ],
      "writes": [
        "target.health"
      ],
      "operation": {
        "kind": "damage.commit-health"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.radial.commit-health",
      "description": "Commit final Radial Hit damage to the resolved Health layer.",
      "phase": "damage.commit",
      "eventKind": "damage.radial",
      "reads": [
        "event.damage",
        "target.health"
      ],
      "writes": [
        "target.health"
      ],
      "operation": {
        "kind": "damage.commit-health"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.status.commit-resolved-tick-health",
      "description": "Commit one resolved synthetic Status tick to the target Health layer.",
      "phase": "damage.commit",
      "eventKind": "damage.status-tick",
      "reads": [
        "event.damage",
        "target.health"
      ],
      "writes": [
        "target.health"
      ],
      "operation": {
        "kind": "damage.commit-health"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.critical.aggregate-expected-branches",
      "description": "After every reachable adjacent Critical tier branch reaches terminal Health commit, weight its final Damage Vector and remaining Health by the branch probability.",
      "phase": "result.aggregate",
      "eventKind": "damage.direct",
      "reads": [
        "branch.damage",
        "branch.health",
        "branch.weight"
      ],
      "writes": [
        "event.damage",
        "target.health"
      ],
      "operation": {
        "kind": "damage-vector.aggregate-weighted-branches"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.multishot.aggregate-fixed-hits",
      "description": "After every emitted Direct Hit reaches terminal Health commit in stable index order, sum the hit Damage Vectors and preserve the final sequential remaining Health.",
      "phase": "result.aggregate",
      "eventKind": "action.multishot-direct-hit",
      "reads": [
        "hit.damage",
        "hit.health-before",
        "hit.health-after"
      ],
      "writes": [
        "event.damage",
        "target.health"
      ],
      "operation": {
        "kind": "damage-vector.aggregate-sequential-hits"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.pellet.aggregate-fixed-hits",
      "description": "After every emitted pellet Direct Hit reaches terminal Health commit in stable index order, sum the hit Damage Vectors and preserve the final sequential remaining Health.",
      "phase": "result.aggregate",
      "eventKind": "action.pellet-direct-hit",
      "reads": [
        "hit.damage",
        "hit.health-before",
        "hit.health-after"
      ],
      "writes": [
        "event.damage",
        "target.health"
      ],
      "operation": {
        "kind": "damage-vector.aggregate-sequential-pellets"
      },
      "evidenceStatus": "experimental",
      "evidenceIds": []
    },
    {
      "id": "rule.status.aggregate-resolved-ticks",
