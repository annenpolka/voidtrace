                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "evidenceStatus": {
                "description": "Evidence status of the rule at evaluation time.",
                "type": "string",
                "enum": [
                  "verified",
                  "experimental",
                  "disputed",
                  "unsupported",
                  "approximated"
                ]
              },
              "evidenceIds": {
                "description": "Stable evidence identifiers supporting or qualifying the rule.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                }
              },
              "rejectionStage": {
                "description": "Stage at which this rule decision was rejected.",
                "type": "string",
                "const": "predicate"
              },
              "rejectionReason": {
                "description": "Structured explanation of why the rule was not applied.",
                "type": "object",
                "properties": {
                  "code": {
                    "description": "Stable machine-readable rejection code.",
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                  },
                  "message": {
                    "description": "Human-readable explanation of the rejection.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              "matched": {
                "description": "Predicate rejection means the event predicate did not match.",
                "type": "boolean",
                "const": false
              }
            },
            "required": [
              "outcome",
              "sequence",
              "eventId",
              "eventTimeMs",
              "phase",
              "ruleId",
              "reads",
              "evidenceStatus",
              "evidenceIds",
              "rejectionStage",
              "rejectionReason",
              "matched"
            ],
            "additionalProperties": false
          },
