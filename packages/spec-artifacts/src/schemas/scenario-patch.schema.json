{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voidtrace:schema:scenario-patch:0.1.0",
  "title": "ScenarioPatch",
  "description": "Immutable bounded scalar replacements that materialize one Scenario revision from an exact base Scenario reference.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Schema identifier used to validate this Artifact.",
      "type": "string",
      "const": "urn:voidtrace:schema:scenario-patch:0.1.0"
    },
    "kind": {
      "description": "Stable discriminator for this Artifact kind.",
      "type": "string",
      "const": "voidtrace.scenario-patch"
    },
    "schemaVersion": {
      "description": "Version of this Artifact contract.",
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "description": "Stable identity of this Artifact.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "revision": {
      "description": "Non-negative immutable revision of this Artifact.",
      "type": "integer",
      "minimum": 0
    },
    "createdFrom": {
      "description": "Optional Artifact revision from which this Artifact was derived.",
      "allOf": [
        {
          "$ref": "urn:voidtrace:schema:artifact-ref:0.1.0"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "voidtrace.scenario-patch"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "contentHash": {
      "description": "SHA-256 fingerprint of the canonical Artifact excluding this top-level contentHash field.",
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gameBuild": {
      "description": "Game build against which this Artifact is defined.",
      "type": "string",
      "minLength": 1
    },
    "baseScenarioRef": {
      "description": "Exact immutable Scenario revision to which every replacement applies.",
      "allOf": [
        {
          "$ref": "urn:voidtrace:schema:artifact-ref:0.1.0"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "voidtrace.scenario"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "resultScenario": {
      "description": "Explicit identity assigned to the materialized Scenario.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identity declared for the materialized Scenario.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "revision": {
          "description": "Non-negative immutable revision declared for the materialized Scenario.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "operations": {
      "description": "One to 64 ordered, unique scalar replacement operations.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "description": "Finite Patch operation; ScenarioPatch 0.1.0 accepts replace only.",
            "type": "string",
            "const": "replace"
          },
          "path": {
            "description": "Allowed JSON Pointer to one existing scalar Scenario leaf; keys use ~0 and ~1 escaping and array indices are canonical decimals.",
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?:attacker/configuration/(?:[^~/]|~0|~1)+|targets/(?:0|[1-9][0-9]*)/configuration/(?:[^~/]|~0|~1)+|targetGraph/relations/(?:0|[1-9][0-9]*)/(?:resolvedDistanceMeters|lineOfSightClear|resolvedHitCount)|initialState/(?:[^~/]|~0|~1)+|actionPlan/(?:0|[1-9][0-9]*)/parameters/(?:[^~/]|~0|~1)+|simulation/timeLimitMs|metrics/(?:0|[1-9][0-9]*))$"
          },
          "value": {
            "description": "Finite replacement scalar; object, array, and non-JSON values are unsupported.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "contentHash",
    "gameBuild",
    "baseScenarioRef",
    "resultScenario",
    "operations"
  ],
  "additionalProperties": false
}
