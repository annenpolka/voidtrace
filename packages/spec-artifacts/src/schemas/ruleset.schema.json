{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voidtrace:schema:ruleset:0.18.0",
  "title": "Ruleset",
  "description": "Generated finite Rule IR interpreted by the Kernel-facing Rules package.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Schema identifier used to validate this Artifact.",
      "type": "string",
      "const": "urn:voidtrace:schema:ruleset:0.18.0"
    },
    "kind": {
      "description": "Stable discriminator for this Artifact kind.",
      "type": "string",
      "const": "ruleset"
    },
    "schemaVersion": {
      "description": "Version of this Artifact contract.",
      "type": "string",
      "const": "0.18.0"
    },
    "id": {
      "description": "Stable identity of this Artifact.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "revision": {
      "description": "Non-negative immutable revision of this Artifact.",
      "type": "integer",
      "minimum": 0
    },
    "createdFrom": {
      "description": "Optional Artifact revision from which this Artifact was derived.",
      "allOf": [
        {
          "$ref": "urn:voidtrace:schema:artifact-ref:0.1.0"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ruleset"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "contentHash": {
      "description": "SHA-256 fingerprint of the canonical Artifact excluding this top-level contentHash field.",
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gameBuild": {
      "description": "Game build against which this Artifact is defined.",
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "description": "Ordered finite Rule IR.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Stable normative Rule identity.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "description": {
            "description": "Human-readable normative operation semantics.",
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "description": "Finite execution phase.",
            "type": "string",
            "enum": [
              "attack.emit",
              "damage.construct",
              "critical.roll",
              "critical.expected",
              "critical.resolve",
              "damage.radial-falloff",
              "status.tick",
              "target.mitigate",
              "damage.commit",
              "result.aggregate"
            ]
          },
          "eventKind": {
            "description": "Stable event discriminator matched by this Rule.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "reads": {
            "description": "Declared scalar or vector paths read by this Rule.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "writes": {
            "description": "Declared scalar or vector paths written by this Rule.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "operation": {
            "description": "Finite executable operation selected by this Rule.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved Multishot action into an explicit bounded count of ordered Direct Hit events.",
                    "type": "string",
                    "const": "event.expand-fixed-multishot"
                  },
                  "maximumHits": {
                    "description": "Positive safe execution bound for one resolved Multishot action.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumHits"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved pellet action into an explicit bounded count of ordered Direct Hit events.",
                    "type": "string",
                    "const": "event.expand-fixed-pellets"
                  },
                  "maximumPellets": {
                    "description": "Positive safe execution bound for one resolved pellet action.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumPellets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved target-specific pellet allocation into an explicit bounded count of Direct Hit events.",
                    "type": "string",
                    "const": "event.expand-resolved-pellet-allocation"
                  },
                  "maximumPellets": {
                    "description": "Positive safe execution bound for one resolved pellet allocation.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumPellets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved Status action into an explicit bounded count of ordered logical-time tick events.",
                    "type": "string",
                    "const": "event.expand-resolved-status-ticks"
                  },
                  "maximumTicks": {
                    "description": "Positive safe execution bound for one resolved Status action.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTicks"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved Beam action into an explicit bounded count of ordered logical-time tick events.",
                    "type": "string",
                    "const": "event.expand-resolved-beam-ticks"
                  },
                  "maximumTicks": {
                    "description": "Positive safe execution bound for one resolved Beam action.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTicks"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved punch-through path into an explicit bounded count of ordered target events.",
                    "type": "string",
                    "const": "event.expand-resolved-punch-through-targets"
                  },
                  "maximumTargets": {
                    "description": "Positive safe execution bound for one resolved punch-through path.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTargets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved ricochet path into an explicit bounded count of ordered target events.",
                    "type": "string",
                    "const": "event.expand-resolved-ricochet-targets"
                  },
                  "maximumTargets": {
                    "description": "Positive safe execution bound for one resolved ricochet path.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTargets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved chain path into an explicit bounded count of ordered target events.",
                    "type": "string",
                    "const": "event.expand-resolved-chain-targets"
                  },
                  "maximumTargets": {
                    "description": "Positive safe execution bound for one resolved chain path.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTargets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved Radial impact relation set into an explicit bounded count of target events.",
                    "type": "string",
                    "const": "event.expand-resolved-radial-targets"
                  },
                  "maximumTargets": {
                    "description": "Positive safe execution bound for one resolved Radial impact.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTargets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Expand one resolved impact into one Direct child and a bounded resolved Radial target set.",
                    "type": "string",
                    "const": "event.expand-resolved-direct-radial-impact"
                  },
                  "maximumTargets": {
                    "description": "Positive safe execution bound for one resolved Direct plus Radial impact.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "maximumTargets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Copy the input base Damage Vector into event damage.",
                    "type": "string",
                    "const": "damage-vector.copy"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Construct one synthetic Status tick Damage Vector from explicit resolved Health damage.",
                    "type": "string",
                    "const": "damage-vector.copy-resolved-status-tick"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Resolve safe non-negative Critical tiers from an explicit roll and the fractional part of Critical chance; integer chance keeps next tier equal to base tier.",
                    "type": "string",
                    "const": "critical-tier.resolve-tier-roll"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Resolve the safe non-negative adjacent Critical tiers and their probabilities without selecting a realized tier.",
                    "type": "string",
                    "const": "critical-tier.resolve-expected-branches"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Scale by 1 + resolved Critical tier * (Critical multiplier - 1).",
                    "type": "string",
                    "const": "damage-vector.scale-critical-tier"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Scale Radial Hit damage by an explicit resolved multiplier in [0, 1].",
                    "type": "string",
                    "const": "damage-vector.scale-resolved-radial-falloff"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Scale by constant divided by resolved Armor plus constant.",
                    "type": "string",
                    "const": "damage-vector.scale-standard-armor"
                  },
                  "constant": {
                    "description": "Positive denominator constant in the standard Armor formula.",
                    "type": "number",
                    "minimum": 1e-12
                  }
                },
                "required": [
                  "kind",
                  "constant"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Commit final event damage to the resolved Health layer.",
                    "type": "string",
                    "const": "damage.commit-health"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal branch Damage Vectors and remaining Health by explicit branch weights.",
                    "type": "string",
                    "const": "damage-vector.aggregate-weighted-branches"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate ordered terminal Direct Hit Damage Vectors and preserve the final sequential Health state.",
                    "type": "string",
                    "const": "damage-vector.aggregate-sequential-hits"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate ordered terminal pellet Damage Vectors and preserve the final sequential Health state.",
                    "type": "string",
                    "const": "damage-vector.aggregate-sequential-pellets"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal Damage and target-specific Health for one resolved pellet allocation.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-pellet-allocation"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate ordered terminal Status tick Damage Vectors and preserve the final sequential Health state.",
                    "type": "string",
                    "const": "damage-vector.aggregate-sequential-status-ticks"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate ordered terminal Beam tick Damage Vectors and preserve the final sequential Health state.",
                    "type": "string",
                    "const": "damage-vector.aggregate-sequential-beam-ticks"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal Damage and target-specific Health for a resolved punch-through path.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-punch-through-targets"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal Damage and target-specific Health for a resolved ricochet path.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-ricochet-targets"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal Damage and target-specific Health for a resolved chain path.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-chain-targets"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate terminal Damage and target-specific Health for one resolved Radial impact.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-radial-targets"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "Aggregate Direct and Radial Damage with terminal target-specific Health for one resolved impact.",
                    "type": "string",
                    "const": "damage-vector.aggregate-resolved-direct-radial-impact"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "evidenceStatus": {
            "description": "Game-mechanics evidence status, independent of implementation maturity.",
            "type": "string",
            "enum": [
              "verified",
              "experimental",
              "disputed",
              "unsupported",
              "approximated"
            ]
          },
          "evidenceIds": {
            "description": "Evidence identities supporting or qualifying this Rule.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "description",
          "phase",
          "eventKind",
          "reads",
          "writes",
          "operation",
          "evidenceStatus",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "contentHash",
    "gameBuild",
    "rules"
  ],
  "additionalProperties": false
}
