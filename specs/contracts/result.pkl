/// Reproducible evaluation output and its explicit coverage qualifications.
module voidtrace.contracts.result

import "artifact.pkl"
import "model.pkl"

local schemaIdentifier = "urn:voidtrace:schema:result:0.2.0"
local contractVersion = "0.2.0"

function nonEmptyString(): model.StringNode = new model.StringNode {
  minLength = 1
}

function stringValues(allowedValues: Listing<String>): model.StringNode = new model.StringNode {
  values = allowedValues
}

function stringArray(): model.ArrayNode = new model.ArrayNode {
  items = artifact.stableId()
}

function scalarValue(): model.UnionNode = new model.UnionNode {
  variants = new {
    new model.StringNode {}
    new model.NumberNode {}
    new model.BooleanNode {}
    new model.NullNode {}
  }
}

function artifactReference(expectedKindValue: String): model.RefNode = new model.RefNode {
  target = "artifact-ref"
  expectedKind = expectedKindValue
}

function coverage(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "verified"
      description = "Mechanic identifiers covered by verified rules."
      required = true
      schema = stringArray()
    }
    new model.Field {
      name = "experimental"
      description = "Mechanic identifiers covered by experimental rules."
      required = true
      schema = stringArray()
    }
    new model.Field {
      name = "disputed"
      description = "Mechanic identifiers whose interpretation remains disputed."
      required = true
      schema = stringArray()
    }
    new model.Field {
      name = "unsupported"
      description = "Mechanic identifiers explicitly excluded from this Result."
      required = true
      schema = stringArray()
    }
    new model.Field {
      name = "approximated"
      description = "Mechanic identifiers evaluated with an explicit approximation."
      required = true
      schema = stringArray()
    }
  }
}

function assumption(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "id"
      description = "Stable identifier of the assumption."
      required = true
      schema = artifact.stableId()
    }
    new model.Field {
      name = "status"
      description = "Evidence status qualifying this assumption."
      required = true
      schema =
        stringValues(new Listing<String> {
          "verified"
          "experimental"
          "disputed"
          "unsupported"
          "approximated"
        })
    }
    new model.Field {
      name = "impact"
      description = "Estimated impact of the assumption on the Result."
      required = true
      schema =
        stringValues(new Listing<String> {
          "low"
          "medium"
          "high"
        })
    }
    new model.Field {
      name = "description"
      description = "Human-readable statement of the assumption."
      required = true
      schema = nonEmptyString()
    }
  }
}

function warning(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "code"
      description = "Stable machine-readable warning code."
      required = true
      schema = artifact.stableId()
    }
    new model.Field {
      name = "message"
      description = "Human-readable warning message."
      required = true
      schema = nonEmptyString()
    }
    new model.Field {
      name = "pointer"
      description = "Optional JSON Pointer locating the input or output that caused the warning."
      required = false
      schema = nonEmptyString()
    }
  }
}

function targetState(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "health"
      description = "Finite non-negative terminal Health for this Scenario target."
      required = true
      schema = new model.NumberNode {
        minimum = 0
      }
    }
  }
}

result: model.Contract = new {
  id = "result"
  typeName = "Result"
  schemaId = schemaIdentifier
  version = contractVersion
  description = "Versioned evaluation output with explicit provenance, coverage, and limitations."
  root = new model.ObjectNode {
    fields = (
      artifact.envelopeFields(
        schemaIdentifier,
        "voidtrace.result",
        contractVersion,
      )
    ) {
      new model.Field {
        name = "scenarioRef"
        description = "Scenario revision evaluated to produce this Result."
        required = true
        schema = artifactReference("voidtrace.scenario")
      }
      new model.Field {
        name = "fingerprint"
        description = "Immutable input fingerprint for the execution that produced this Result."
        required = true
        schema = new model.RefNode {
          target = "fingerprint"
        }
      }
      new model.Field {
        name = "coverage"
        description = "Evidence and support classification of mechanics affecting this Result."
        required = true
        schema = coverage()
      }
      new model.Field {
        name = "metrics"
        description = "Computed scalar metrics keyed by stable metric identifier."
        required = true
        schema = new model.RecordNode {
          values = new model.NumberNode {}
          keySchema = artifact.stableId()
        }
      }
      new model.Field {
        name = "damageBySource"
        description = "Non-negative damage totals keyed by stable source identifier."
        required = true
        schema = new model.RecordNode {
          values = new model.NumberNode {
            minimum = 0
          }
          keySchema = artifact.stableId()
        }
      }
      new model.Field {
        name = "damageByType"
        description = "Non-negative damage totals keyed by stable damage-type identifier."
        required = true
        schema = new model.RecordNode {
          values = new model.NumberNode {
            minimum = 0
          }
          keySchema = artifact.stableId()
        }
      }
      new model.Field {
        name = "targetStates"
        description = "Terminal state projection keyed by Scenario target identity."
        required = true
        schema = new model.RecordNode {
          values = targetState()
          keySchema = artifact.stableId()
        }
      }
      new model.Field {
        name = "resolvedDefaults"
        description =
          "Every default resolved during evaluation, represented as explicit scalar values."
        required = true
        schema = new model.RecordNode {
          values = scalarValue()
        }
      }
      new model.Field {
        name = "assumptions"
        description = "Assumptions that qualify interpretation of this Result."
        required = true
        schema = new model.ArrayNode {
          items = assumption()
        }
      }
      new model.Field {
        name = "warnings"
        description = "Structured warnings emitted without silently changing mechanics."
        required = true
        schema = new model.ArrayNode {
          items = warning()
        }
      }
      new model.Field {
        name = "traceRef"
        description = "Optional reference to the causal Trace produced with this Result."
        required = false
        schema = artifactReference("voidtrace.trace")
      }
    }
  }
}
