/// Generated executable Rule IR and its immutable Artifact envelope.
module voidtrace.contracts.ruleset

import "artifact.pkl"
import "model.pkl"

local schemaIdentifier = "urn:voidtrace:schema:ruleset:0.10.0"
local contractVersion = "0.10.0"

function nonEmptyString(): model.StringNode = new model.StringNode {
  minLength = 1
}

function stableIdArray(): model.ArrayNode = new model.ArrayNode {
  items = artifact.stableId()
}

function evidenceStatus(): model.StringNode = new model.StringNode {
  values = new Listing<String> {
    "verified"
    "experimental"
    "disputed"
    "unsupported"
    "approximated"
  }
}

function copyDamageVector(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description = "Copy the input base Damage Vector into event damage."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.copy"
      }
    }
  }
}

function expandFixedMultishot(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Expand one resolved Multishot action into an explicit bounded count of ordered Direct Hit events."
      required = true
      schema = new model.LiteralNode {
        value = "event.expand-fixed-multishot"
      }
    }
    new model.Field {
      name = "maximumHits"
      description = "Positive safe execution bound for one resolved Multishot action."
      required = true
      schema = new model.IntegerNode {
        minimum = 1
      }
    }
  }
}

function expandFixedPellets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Expand one resolved pellet action into an explicit bounded count of ordered Direct Hit events."
      required = true
      schema = new model.LiteralNode {
        value = "event.expand-fixed-pellets"
      }
    }
    new model.Field {
      name = "maximumPellets"
      description = "Positive safe execution bound for one resolved pellet action."
      required = true
      schema = new model.IntegerNode {
        minimum = 1
      }
    }
  }
}

function expandResolvedStatusTicks(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Expand one resolved Status action into an explicit bounded count of ordered logical-time tick events."
      required = true
      schema = new model.LiteralNode {
        value = "event.expand-resolved-status-ticks"
      }
    }
    new model.Field {
      name = "maximumTicks"
      description = "Positive safe execution bound for one resolved Status action."
      required = true
      schema = new model.IntegerNode {
        minimum = 1
      }
    }
  }
}

function expandResolvedPunchThroughTargets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Expand one resolved punch-through path into an explicit bounded count of ordered target events."
      required = true
      schema = new model.LiteralNode {
        value = "event.expand-resolved-punch-through-targets"
      }
    }
    new model.Field {
      name = "maximumTargets"
      description = "Positive safe execution bound for one resolved punch-through path."
      required = true
      schema = new model.IntegerNode {
        minimum = 1
      }
    }
  }
}

function expandResolvedRicochetTargets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Expand one resolved ricochet path into an explicit bounded count of ordered target events."
      required = true
      schema = new model.LiteralNode {
        value = "event.expand-resolved-ricochet-targets"
      }
    }
    new model.Field {
      name = "maximumTargets"
      description = "Positive safe execution bound for one resolved ricochet path."
      required = true
      schema = new model.IntegerNode {
        minimum = 1
      }
    }
  }
}

function resolveCriticalTierRoll(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Resolve safe non-negative Critical tiers from an explicit roll and the fractional part of Critical chance; integer chance keeps next tier equal to base tier."
      required = true
      schema = new model.LiteralNode {
        value = "critical-tier.resolve-tier-roll"
      }
    }
  }
}

function resolveExpectedCriticalBranches(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Resolve the safe non-negative adjacent Critical tiers and their probabilities without selecting a realized tier."
      required = true
      schema = new model.LiteralNode {
        value = "critical-tier.resolve-expected-branches"
      }
    }
  }
}

function scaleCriticalTier(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description = "Scale by 1 + resolved Critical tier * (Critical multiplier - 1)."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.scale-critical-tier"
      }
    }
  }
}

function scaleStandardArmor(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description = "Scale by constant divided by resolved Armor plus constant."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.scale-standard-armor"
      }
    }
    new model.Field {
      name = "constant"
      description = "Positive denominator constant in the standard Armor formula."
      required = true
      schema = new model.NumberNode {
        minimum = 0.000000000001
      }
    }
  }
}

function scaleResolvedRadialFalloff(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description = "Scale Radial Hit damage by an explicit resolved multiplier in [0, 1]."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.scale-resolved-radial-falloff"
      }
    }
  }
}

function copyResolvedStatusTickDamage(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Construct one synthetic Status tick Damage Vector from explicit resolved Health damage."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.copy-resolved-status-tick"
      }
    }
  }
}

function commitHealthDamage(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description = "Commit final event damage to the resolved Health layer."
      required = true
      schema = new model.LiteralNode {
        value = "damage.commit-health"
      }
    }
  }
}

function aggregateWeightedBranches(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate terminal branch Damage Vectors and remaining Health by explicit branch weights."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-weighted-branches"
      }
    }
  }
}

function aggregateSequentialHits(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate ordered terminal Direct Hit Damage Vectors and preserve the final sequential Health state."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-sequential-hits"
      }
    }
  }
}

function aggregateSequentialPellets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate ordered terminal pellet Damage Vectors and preserve the final sequential Health state."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-sequential-pellets"
      }
    }
  }
}

function aggregateSequentialStatusTicks(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate ordered terminal Status tick Damage Vectors and preserve the final sequential Health state."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-sequential-status-ticks"
      }
    }
  }
}

function aggregateResolvedPunchThroughTargets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate terminal Damage and target-specific Health for a resolved punch-through path."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-resolved-punch-through-targets"
      }
    }
  }
}

function aggregateResolvedRicochetTargets(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "kind"
      description =
        "Aggregate terminal Damage and target-specific Health for a resolved ricochet path."
      required = true
      schema = new model.LiteralNode {
        value = "damage-vector.aggregate-resolved-ricochet-targets"
      }
    }
  }
}

function rule(): model.ObjectNode = new model.ObjectNode {
  fields = new {
    new model.Field {
      name = "id"
      description = "Stable normative Rule identity."
      required = true
      schema = artifact.stableId()
    }
    new model.Field {
      name = "description"
      description = "Human-readable normative operation semantics."
      required = true
      schema = nonEmptyString()
    }
    new model.Field {
      name = "phase"
      description = "Finite execution phase."
      required = true
      schema = new model.StringNode {
        values = new Listing<String> {
          "attack.emit"
          "damage.construct"
          "critical.roll"
          "critical.expected"
          "critical.resolve"
          "damage.radial-falloff"
          "status.tick"
          "target.mitigate"
          "damage.commit"
          "result.aggregate"
        }
      }
    }
    new model.Field {
      name = "eventKind"
      description = "Stable event discriminator matched by this Rule."
      required = true
      schema = artifact.stableId()
    }
    new model.Field {
      name = "reads"
      description = "Declared scalar or vector paths read by this Rule."
      required = true
      schema = stableIdArray()
    }
    new model.Field {
      name = "writes"
      description = "Declared scalar or vector paths written by this Rule."
      required = true
      schema = stableIdArray()
    }
    new model.Field {
      name = "operation"
      description = "Finite executable operation selected by this Rule."
      required = true
      schema = new model.UnionNode {
        variants = new {
          expandFixedMultishot()
          expandFixedPellets()
          expandResolvedStatusTicks()
          expandResolvedPunchThroughTargets()
          expandResolvedRicochetTargets()
          copyDamageVector()
          copyResolvedStatusTickDamage()
          resolveCriticalTierRoll()
          resolveExpectedCriticalBranches()
          scaleCriticalTier()
          scaleResolvedRadialFalloff()
          scaleStandardArmor()
          commitHealthDamage()
          aggregateWeightedBranches()
          aggregateSequentialHits()
          aggregateSequentialPellets()
          aggregateSequentialStatusTicks()
          aggregateResolvedPunchThroughTargets()
          aggregateResolvedRicochetTargets()
        }
      }
    }
    new model.Field {
      name = "evidenceStatus"
      description = "Game-mechanics evidence status, independent of implementation maturity."
      required = true
      schema = evidenceStatus()
    }
    new model.Field {
      name = "evidenceIds"
      description = "Evidence identities supporting or qualifying this Rule."
      required = true
      schema = stableIdArray()
    }
  }
}

ruleset: model.Contract = new {
  id = "ruleset"
  typeName = "Ruleset"
  schemaId = schemaIdentifier
  version = contractVersion
  description = "Generated finite Rule IR interpreted by the Kernel-facing Rules package."
  root = new model.ObjectNode {
    fields = (
      artifact.envelopeFields(
        schemaIdentifier,
        "ruleset",
        contractVersion,
      )
    ) {
      new model.Field {
        name = "rules"
        description = "Ordered finite Rule IR."
        required = true
        schema = new model.ArrayNode {
          items = rule()
        }
      }
    }
  }
}
