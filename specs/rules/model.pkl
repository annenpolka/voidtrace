/// Finite runtime Rule IR emitted by the normative specification.
module voidtrace.rules.model

typealias RulePhase =
  "attack.emit"
    | "critical.expected"
    | "damage.construct"
    | "critical.roll"
    | "critical.resolve"
    | "damage.radial-falloff"
    | "status.tick"
    | "target.mitigate"
    | "damage.commit"
    | "result.aggregate"

typealias RuleEvidenceStatus =
  "verified" | "experimental" | "disputed" | "unsupported" | "approximated"

abstract class RuleOperation {
  kind: String
}

class CopyDamageVector extends RuleOperation {
  kind = "damage-vector.copy"
}

class ResolveCriticalTierRoll extends RuleOperation {
  kind = "critical-tier.resolve-tier-roll"
}

class ResolveExpectedCriticalBranches extends RuleOperation {
  kind = "critical-tier.resolve-expected-branches"
}

class ScaleCriticalTier extends RuleOperation {
  kind = "damage-vector.scale-critical-tier"
}

class ScaleStandardArmor extends RuleOperation {
  kind = "damage-vector.scale-standard-armor"
  constant: Number(isPositive)
}

class ScaleResolvedRadialFalloff extends RuleOperation {
  kind = "damage-vector.scale-resolved-radial-falloff"
}

class ExpandResolvedStatusTicks extends RuleOperation {
  kind = "event.expand-resolved-status-ticks"
  maximumTicks: UInt(isPositive)
}

class ExpandResolvedPunchThroughTargets extends RuleOperation {
  kind = "event.expand-resolved-punch-through-targets"
  maximumTargets: UInt(isPositive)
}

class ExpandResolvedRicochetTargets extends RuleOperation {
  kind = "event.expand-resolved-ricochet-targets"
  maximumTargets: UInt(isPositive)
}

class ExpandResolvedChainTargets extends RuleOperation {
  kind = "event.expand-resolved-chain-targets"
  maximumTargets: UInt(isPositive)
}

class ExpandResolvedRadialTargets extends RuleOperation {
  kind = "event.expand-resolved-radial-targets"
  maximumTargets: UInt(isPositive)
}

class CopyResolvedStatusTickDamage extends RuleOperation {
  kind = "damage-vector.copy-resolved-status-tick"
}

class AggregateSequentialStatusTicks extends RuleOperation {
  kind = "damage-vector.aggregate-sequential-status-ticks"
}

class AggregateResolvedPunchThroughTargets extends RuleOperation {
  kind = "damage-vector.aggregate-resolved-punch-through-targets"
}

class AggregateResolvedRicochetTargets extends RuleOperation {
  kind = "damage-vector.aggregate-resolved-ricochet-targets"
}

class AggregateResolvedChainTargets extends RuleOperation {
  kind = "damage-vector.aggregate-resolved-chain-targets"
}

class AggregateResolvedRadialTargets extends RuleOperation {
  kind = "damage-vector.aggregate-resolved-radial-targets"
}

class CommitHealthDamage extends RuleOperation {
  kind = "damage.commit-health"
}

class AggregateWeightedBranches extends RuleOperation {
  kind = "damage-vector.aggregate-weighted-branches"
}

class AggregateSequentialHits extends RuleOperation {
  kind = "damage-vector.aggregate-sequential-hits"
}

class AggregateSequentialPellets extends RuleOperation {
  kind = "damage-vector.aggregate-sequential-pellets"
}

class ExpandFixedMultishot extends RuleOperation {
  kind = "event.expand-fixed-multishot"
  maximumHits: UInt(isPositive)
}

class ExpandFixedPellets extends RuleOperation {
  kind = "event.expand-fixed-pellets"
  maximumPellets: UInt(isPositive)
}

class Rule {
  id: String(matches(Regex(#"[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*"#)))
  description: String(length > 0)
  phase: RulePhase
  eventKind: String(matches(Regex(#"[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*"#)))
  reads: Listing<String>
  writes: Listing<String>
  operation: RuleOperation
  evidenceStatus: RuleEvidenceStatus
  evidenceIds: Listing<String>
}

class Ruleset {
  id: String(matches(Regex(#"[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*"#)))
  version: String(matches(Regex(#"\d+\.\d+\.\d+"#)))
  revision: UInt
  gameBuild: String(length > 0)
  rules: Listing<Rule>
}
