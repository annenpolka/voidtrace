title = "VoidTrace Normative Specification"
schemaVersion = "0.1.0"

clauses: Listing<base.Clause> = new {
  scope.geometryIsResolvedInput
  scope.unsupportedIsExplicit
  determinism.sameInputsReplay
  `event-ordering`.eventTimeNeverRegresses
  rng.logicalCoordinateIsStable
  mechanicsClauses.directDamageIdentity
  mechanicsClauses.damageTotalIsComponentSum
  mechanicsClauses.criticalProbabilityIsNormalized
  mechanicsClauses.criticalTierUsesGeneralScale
  mechanicsClauses.criticalExpectedValueUsesTerminalBranches
  mechanicsClauses.fixedMultishotEmitsOrderedHits
  mechanicsClauses.fixedPelletActionEmitsOrderedHits
  mechanicsClauses.armorDoesNotIncreaseDamage
  mechanicsClauses.armorThreeHundredHalvesDamage
  mechanicsClauses.traceReconstructsDamage
