import "rules/model.pkl" as ruleModel

title = "VoidTrace Normative Specification"
schemaVersion = "0.1.0"

clauses: Listing<base.Clause> = new {
  scope.geometryIsResolvedInput
  scope.unsupportedIsExplicit
  scope.targetGraphIsResolvedAndExplicit
  determinism.sameInputsReplay
  `event-ordering`.eventTimeNeverRegresses
  rng.logicalCoordinateIsStable
  mechanicsClauses.directDamageIdentity
  mechanicsClauses.damageTotalIsComponentSum
  mechanicsClauses.criticalProbabilityIsNormalized
  mechanicsClauses.criticalTierUsesGeneralScale
  mechanicsClauses.criticalExpectedValueUsesTerminalBranches
  mechanicsClauses.fixedMultishotEmitsOrderedHits
  mechanicsClauses.fixedPelletActionEmitsOrderedHits
  mechanicsClauses.resolvedRadialFalloffScalesDamage
  mechanicsClauses.resolvedRadialTargetsUseDistanceAndLos
  mechanicsClauses.resolvedStatusTicksCommitInTimeOrder
  mechanicsClauses.resolvedPunchThroughVisitsTargetsInPathOrder
  mechanicsClauses.resolvedRicochetVisitsTargetsInPathOrder
  mechanicsClauses.resolvedChainVisitsTargetsInPathOrder
  mechanicsClauses.armorDoesNotIncreaseDamage
  mechanicsClauses.armorThreeHundredHalvesDamage
  mechanicsClauses.traceReconstructsDamage
  mechanicsClauses.rejectedRuleHasReason
  `direct-critical-armor`.roundTrip
  `probability-critical-armor`.roundTrip
  `tier-2-critical-armor`.roundTrip
  `expected-critical-armor`.roundTrip
  `multishot-critical-armor`.roundTrip
  `pellet-critical-armor`.roundTrip
  `radial-critical-armor`.roundTrip
  `resolved-radial-targets`.roundTrip
  `resolved-status-ticks`.roundTrip
  `resolved-punch-through`.roundTrip
  `resolved-ricochet`.roundTrip
  `resolved-chain`.roundTrip
  cliSurface.commandOutputSelection
  cliSurface.deterministicJson
  cliSurface.streamExitDiscipline
  cliSurface.aliasEquivalence
  cliSurface.applicationBoundary
  cliSurface.inputSurface
}

contracts: Listing<model.Contract> = new {
  artifact.artifactRef
  artifact.fingerprint
  catalog.catalogSnapshot
  problem.problem
  rulesetContract.ruleset
  scenario.scenario
  result.result
  `trace`.`trace`
}

ruleset: ruleModel.Ruleset = new {
  id = "ruleset.synthetic-core"
  version = "0.12.0"
  revision = 1
  gameBuild = "synthetic-fixture-0"
  rules {
    multishot.emitFixedRule
    pellet.emitFixedRule
    status.scheduleResolvedTicksRule
    `punch-through`.expandResolvedTargetsRule
    ricochet.expandResolvedTargetsRule
    chain.expandResolvedTargetsRule
    radial.expandResolvedTargetsRule
    critical.resolveExpectedBranchesRule
    `direct-hit`.rule
    radial.constructRule
    critical.resolveTierRollRule
    critical.scaleTierRule
    radial.scaleCriticalTierRule
    radial.applyResolvedFalloffRule
    status.constructResolvedTickRule
    defense.rule
    radial.armorRule
    `direct-hit`.commitRule
    radial.commitRule
    status.commitResolvedTickRule
    critical.aggregateExpectedBranchesRule
    multishot.aggregateFixedRule
    pellet.aggregateFixedRule
    status.aggregateResolvedTicksRule
    `punch-through`.aggregateResolvedTargetsRule
    ricochet.aggregateResolvedTargetsRule
    chain.aggregateResolvedTargetsRule
    radial.aggregateResolvedTargetsRule
  }
}
