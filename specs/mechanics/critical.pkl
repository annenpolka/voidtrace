/// Experimental generalized Critical tier resolution for explicit deterministic rolls and tiers.
module voidtrace.mechanics.critical

import "../rules/model.pkl"

resolveTierRollRule: model.Rule = new {
  id = "rule.critical.resolve-tier-roll"
  description =
    "For non-negative Critical chance c, let baseTier = floor(c) and fraction = c - baseTier. baseTier must be a safe integer; nextTier is baseTier when fraction is 0, otherwise baseTier + 1 and must also be safe. Resolve p(baseTier) = 1 - fraction and p(nextTier) = fraction from an explicit roll in [0, 1): nextTier exactly when roll is less than fraction, otherwise baseTier."
  phase = "critical.roll"
  eventKind = "damage.direct"
  reads {
    "attack.critical-chance"
    "event.critical-roll"
  }
  writes {
    "event.critical-tier"
    "event.critical-base-tier"
    "event.critical-next-tier"
    "event.critical-fraction"
    "event.critical-base-tier-probability"
    "event.critical-next-tier-probability"
  }
  operation = new model.ResolveCriticalTierRoll {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

resolveExpectedBranchesRule: model.Rule = new {
  id = "rule.critical.resolve-expected-branches"
  description =
    "For non-negative Critical chance c, resolve the same safe adjacent-tier probability distribution as explicit-roll resolution without selecting a realized tier."
  phase = "critical.expected"
  eventKind = "damage.direct"
  reads {
    "attack.critical-chance"
  }
  writes {
    "event.critical-base-tier"
    "event.critical-next-tier"
    "event.critical-fraction"
    "event.critical-base-tier-probability"
    "event.critical-next-tier-probability"
  }
  operation = new model.ResolveExpectedCriticalBranches {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

scaleTierRule: model.Rule = new {
  id = "rule.critical.scale-tier"
  description =
    "For a resolved non-negative safe-integer Critical tier t and Catalog Critical multiplier M, scale event damage by 1 + t * (M - 1)."
  phase = "critical.resolve"
  eventKind = "damage.direct"
  reads {
    "event.damage"
    "event.critical-tier"
    "attack.critical-multiplier"
  }
  writes {
    "event.damage"
  }
  operation = new model.ScaleCriticalTier {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

aggregateExpectedBranchesRule: model.Rule = new {
  id = "rule.critical.aggregate-expected-branches"
  description =
    "After every reachable adjacent Critical tier branch reaches terminal Health commit, weight its final Damage Vector and remaining Health by the branch probability."
  phase = "result.aggregate"
  eventKind = "damage.direct"
  reads {
    "branch.damage"
    "branch.health"
    "branch.weight"
  }
  writes {
    "event.damage"
    "target.health"
  }
  operation = new model.AggregateWeightedBranches {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}
