/// Conservative binary Critical resolution for explicit deterministic rolls and fixed tiers.
module voidtrace.mechanics.critical

import "../rules/model.pkl"

binaryRollRule: model.Rule = new {
  id = "rule.critical.resolve-binary-roll"
  description =
    "For Critical chance c in [0, 1], resolve the binary distribution p(tier 0) = 1 - c and p(tier 1) = c from an explicit roll: tier 1 exactly when roll is less than c, otherwise tier 0."
  phase = "critical.roll"
  eventKind = "damage.direct"
  reads {
    "attack.critical-chance"
    "event.critical-roll"
  }
  writes {
    "event.critical-tier"
    "event.critical-tier-0-probability"
    "event.critical-tier-1-probability"
  }
  operation = new model.ResolveBinaryCriticalRoll {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

nonCriticalRule: model.Rule = new {
  id = "rule.critical.fixed-tier-0"
  description =
    "When deterministic fixed Critical tier is 0, preserve event damage with multiplier 1."
  phase = "critical.resolve"
  eventKind = "damage.direct"
  reads {
    "event.damage"
    "event.critical-tier"
    "attack.critical-multiplier"
  }
  writes {
    "event.damage"
  }
  operation = new model.ScaleFixedCritical {
    requiredTier = 0
  }
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

criticalRule: model.Rule = new {
  id = "rule.critical.fixed-tier-1"
  description =
    "When deterministic fixed Critical tier is 1, multiply event damage by the Catalog attack critical multiplier."
  phase = "critical.resolve"
  eventKind = "damage.direct"
  reads {
    "event.damage"
    "event.critical-tier"
    "attack.critical-multiplier"
  }
  writes {
    "event.damage"
  }
  operation = new model.ScaleFixedCritical {
    requiredTier = 1
  }
  evidenceStatus = "experimental"
  evidenceIds = new {}
}
