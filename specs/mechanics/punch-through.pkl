/// Experimental resolved punch-through target path without geometry or attenuation.
module voidtrace.mechanics.punchThrough

import "../rules/model.pkl"

expandResolvedTargetsRule: model.Rule = new {
  id = "rule.punch-through.expand-resolved-targets"
  description =
    "Expand one explicit resolved punch-through path into a bounded ordered sequence of target Direct Hit events."
  phase = "attack.emit"
  eventKind = "action.resolved-punch-through-direct-hits"
  reads {
    "action.target-path-count"
  }
  writes {
    "event.direct-hit-count"
  }
  operation = new model.ExpandResolvedPunchThroughTargets {
    maximumTargets = 64
  }
  evidenceStatus = "experimental"
  evidenceIds = new {}
}

aggregateResolvedTargetsRule: model.Rule = new {
  id = "rule.punch-through.aggregate-resolved-targets"
  description =
    "Aggregate terminal Damage and target-specific Health from every target visited by one resolved punch-through path."
  phase = "result.aggregate"
  eventKind = "action.resolved-punch-through-direct-hits"
  reads {
    "path-target.damage"
    "path-target.health-before"
    "path-target.health-after"
  }
  writes {
    "event.damage"
    "targets.health"
  }
  operation = new model.AggregateResolvedPunchThroughTargets {}
  evidenceStatus = "experimental"
  evidenceIds = new {}
}
